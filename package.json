  "description": "Small, readable pi connector for one LiteLLM gateway: catalog thinking levels, Claude over /v1/messages, honest spend, and a status line that says why.",
  "keywords": [
    "pi-package",
    "pi",
    "litellm"
  ],
  "license": "MIT",
  "author": "Ahmad Nur Salim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anuress/pi-litellm-hub.git"
  },
  "homepage": "https://github.com/anuress/pi-litellm-hub#readme",
  "bugs": {
    "url": "https://github.com/anuress/pi-litellm-hub/issues"
  },
  "type": "module",
  "files": [
    "extensions/"
  ],
  "scripts": {
    "test": "node --test test/",
    "release": "node scripts/release.mjs",
